{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "openrouter/openai/gpt-5.6-luna",
  "compaction": {
    "auto": true,
    "prune": true,
  },
  "instructions": ["instructions/*.md"],
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "reasoning": true,
          "options": { "reasoningEffort": "high", "reasoningSummary": "auto" },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": false,
          "limit": { "context": 128000, "output": 8192 }
        }
      }
    },
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "no-key-required"
      },
      "models": {
        "qwen-27b": {
          "name": "Qwen 3.6 27B",
          "reasoning": true,
          "limit": { "context": 96000, "output": 65536 }
        }
      }
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "cc-safety-net",
    "@tarquinen/opencode-smart-title@latest",
    "@bastiangx/opencode-unmoji@latest",
    "opencode-ntfy.sh"
    // "opencode-websearch-cited@1.2.0", //needs api for search. deferred for now
  ],
  "command": {
    "mystatus": {
      "description": "Query quota usage for all AI accounts",
      "template": "Use the mystatus tool to query quota usage. Return the result as-is without modification."
    }
  },
  "mcp": {
    "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp", "enabled": true },
    "exa": { "type": "remote", "url": "https://mcp.exa.ai/mcp", "enabled": true },
    "gh_grep": { "type": "remote", "url": "https://mcp.grep.app", "enabled": true },
    "sqz": {
      "type": "local",
      "command": ["C:\\Users\\hermes\\.cargo\\bin\\sqz-mcp.exe"],
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": [
        "C:\\Users\\hermes\\AppData\\Local\\Programs\\Python\\Python39\\Scripts\\uvx.exe",
        "--python", "3.11",
        "duckduckgo-mcp-server" // Calling the package's entry point directly
      ],
      "enabled": true
    },
    "semble": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "C:/Users/hermes/mcp-servers/semble",
        "run",
        "semble"
      ],
      "enabled": true
    },
    "home_assistant": {
      "type": "remote",
      "url": "https://homeassistant.gerosalorenzo.com/api/mcp",
      "headers": {
        "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiI2Y2UwMTJkYWYwZTA0MzY5YTY3MTdmNDg3OWVlNzM2YyIsImlhdCI6MTc3OTQzNzM1NiwiZXhwIjoyMDk0Nzk3MzU2fQ.wsAXlKmXNnOXxB2KNLp4LFvCwWeQPXBFeQ6tL7Z1Pjg"
      },
      "enabled": true
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "oauth": {}
    }
  },
  "permission": {
    "canvas_*": "allow",
    "task": "deny",
    "websearch": "allow",
    "websearch_cited": "allow",
    "sqz": "allow"
  },
  "default_agent": "build",

"agent": {
  "build": {
    "description": "Supervising implementation agent. Owns the global task, delegates execution, and keeps coherence across subagents.",
    "model": "openrouter/openai/gpt-5.6-luna",
    "reasoningEffort": "high",
    "options": { "reasoningSummary": "detailed" },
    "temperature": 0.2, //.15 to .25
    "mode": "primary",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "deny",
      "edit": "deny",
      "patch": "deny",
      
      "duckduckgo_*": "deny",
      "websearch*": "deny",
      "webfetch*": "deny",
      "context7_*": "deny",
      "exa_*": "deny",
      "gh_grep_*": "deny",
      "bash": "deny",

      "task": {
        "*": "deny",
        "code": "allow",
        "explore": "allow",
        "research": "allow",
        "review": "allow"
      }
    }
  },

  "plan": {
    "description": "Planning and analysis agent. Read-only by default and optimized for delegation.",
    "model": "openrouter/openai/gpt-5.6-luna",
    "reasoningEffort": "high",
    "options": { "reasoningSummary": "detailed" },
    "temperature": 0.25, //.2 to .3
    "mode": "primary",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "deny",
      "edit": "deny",
      "patch": "deny",

      "duckduckgo_*": "deny",
      "websearch*": "deny",
      "webfetch*": "deny",
      "context7_*": "deny",
      "exa_*": "deny",
      "gh_grep_*": "deny",
      "bash": "deny",
      
      "task": {
        "*": "deny",
        "research": "allow",
        "explore": "allow"
      }
    }
  },

  "code": {
    "description": "Tactical execution agent. Makes scoped code changes and runs narrow verification commands.",
    "hidden": true,
    //REMOTE
    "model": "openrouter/deepseek/deepseek-v4-flash",
    "reasoningEffort": "medium",
    "temperature": 0.6, //.55 to .6
    "options": { "reasoningSummary": "auto" },
    "mode": "subagent",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "allow",
      "edit": "allow",
      "bash": "allow",
      
      "task": {
        "*": "deny"
      }
    }
  },

  "review": {
    "description": "Strict read-only reviewer focused on correctness, regressions, and scope control.",
    "model": "openrouter/deepseek/deepseek-v4-flash",
    "reasoningEffort": "medium",   // correctness review, no need for heavy reasoning
    "options": { "reasoningSummary": "auto" },
    "temperature": 0.1, //.05 to .15
    "mode": "subagent",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "deny",
      "edit": "deny",
      "bash": {
        "git status*": "allow",
        "git diff*": "allow",
        "git log*": "allow",
        "*": "deny"
      },
      "task": {
        "*": "deny"
      }
    }
  },

  "research": {
    "description": "Deep research agent. Decomposes questions, delegates retrieval to fetcher, and synthesizes sourced conclusions.",
    "model": "openrouter/deepseek/deepseek-v4-flash",
    "reasoningEffort": "medium",
    "options": { "reasoningSummary": "detailed" },
    "temperature": 0.35, //.3 to .45
    "mode": "subagent",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "deny",
      "edit": "allow",
      "websearch": "deny",
      "webfetch": "deny",
      "bash": "deny",
      "task": {
        "*": "deny",
        "fetch": "allow"
      }
    }
  },

  "fetch": {
    "description": "Web retrieval worker. Executes searches and fetches, extracts relevant findings, and returns structured results without synthesis.",
    "model": "openrouter/deepseek/deepseek-v4-flash",
    "reasoningEffort": "low",   // retrieval worker, no synthesis needed
    "options": { "reasoningSummary": "auto" },
    "temperature": 0.1, //0 or .1
    "mode": "subagent",
    "hidden": true,
    "permission": {
      "websearch": "allow",
      "webfetch": "allow",
      "read": "deny",
      "glob": "deny",
      "grep": "deny",
      "write": "deny",
      "edit": "deny",
      "bash": "deny",
      "task": {
        "*": "deny"
      }
    }
  },

  "explore": {
    "description": "Read-only codebase scout for reconnaissance and file discovery.",
    "model": "openrouter/deepseek/deepseek-v4-flash",
    "reasoningEffort": "low",
    "options": { "reasoningSummary": "auto" },
    "hidden": true,
    "temperature": 0.2, //0 to .2
    "mode": "subagent",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "deny",
      "edit": "deny",
      "bash": {
        "ls *": "allow",
        "tree *": "allow",
        "cat *": "allow",
        "grep *": "allow",
        "rg *": "allow",
        "*": "deny"
      },
      "task": {
        "*": "deny"
      }
    }
  }
}
}
