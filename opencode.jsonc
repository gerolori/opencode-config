{
  "$schema": "https://opencode.ai/config.json",
  // Pin the validated runtime; upgrade deliberately with `opencode upgrade <version>`.
  "autoupdate": false,
  "model": "openrouter/gpt-6-luna",
  "small_model": "openrouter/deepseek-v4.1-flash",
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 40000,
    "reserved": 100000
  },
  "instructions": ["instructions/*.md"],
  "provider": {
    "openrouter": {
      "options": {},
      "models": {
        "free": {
          "id": "openrouter/free",
          "name": "Free Models Router",
          "reasoning": false,
          "limit": { "context": 200000, "output": 16384 }
        },
        "gpt-5.6-luna": {
          "id": "openai/gpt-5.6-luna",
          "name": "GPT-5.6 Luna",
          "reasoning": true,
          "options": { "reasoningEffort": "high", "reasoningSummary": "auto" },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-6-luna": {
          "id": "openai/gpt-6-luna",
          "name": "GPT-6 Luna",
          "reasoning": true,
          "options": { "reasoningEffort": "high", "reasoningSummary": "auto" },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "deepseek-v4.1-flash-1017": {
          "id": "deepseek/deepseek-v4.1-flash-1017",
          "name": "DeepSeek V4.1 Flash 1017",
          "reasoning": true,
          "options": { "reasoningEffort": "low", "reasoningSummary": "auto" },
          "limit": { "context": 1048576, "output": 32768 }
        },
        "deepseek-v4.1-flash": {
          "id": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "options": { "reasoningEffort": "low", "reasoningSummary": "auto" },
          "limit": { "context": 1048576, "output": 16384 }
        }
      }
    },
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "no-key-required"
      },
      "models": {
        "qwen-27b": {
          "name": "Qwen 3.6 27B",
          "reasoning": true,
          "limit": { "context": 96000, "output": 65536 }
        }
      }
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.1.9",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "cc-safety-net@0.8.2",
    "@tarquinen/opencode-smart-title@0.1.7",
    "@bastiangx/opencode-unmoji@0.3.12",
    "opencode-ntfy.sh@1.1.0"
  ],
  "mcp": {
    "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp", "enabled": true },
    // Base stays disabled. The policy plugin may enable this only when EXA_API_KEY is present.
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": false,
      "oauth": false,
      "headers": { "x-api-key": "{env:EXA_API_KEY}" }
    },
    "gh_grep": { "type": "remote", "url": "https://mcp.grep.app", "enabled": true },
    "sqz": {
      "type": "local",
      // Base uses the portable PATH command; the host hook selects the Windows
      // executable only when this is the standard command.
      "command": ["sqz-mcp"],
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": ["uvx", "--python", "3.11", "duckduckgo-mcp-server"],
      "enabled": true
    },
    // Host-local repo. Base stays disabled; enable through a host override or plugin.
    "semble": {
      "type": "local",
      "command": ["uv", "--directory", "{env:SEMBLE_MCP_DIR}", "run", "semble"],
      "enabled": false
    },
    // Host-local repo. Disabled until the 108/108 connector failures are diagnosed.
    "ebay": {
      "type": "local",
      "command": ["uv", "--directory", "{env:EBAY_MCP_DIR}", "run", "ebay-mcp"],
      "environment": {
        "EBAY_CLIENT_ID": "{env:EBAY_CLIENT_ID}",
        "EBAY_CLIENT_SECRET": "{env:EBAY_CLIENT_SECRET}",
        "EBAY_ENV": "{env:EBAY_ENV}"
      },
      "enabled": false
    },
    "home_assistant": {
      "type": "remote",
      // The host hook enables this only when HA_BEARER_TOKEN is present.
      "url": "{env:HA_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:HA_BEARER_TOKEN}"
      },
      "enabled": false
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "oauth": {},
      "enabled": true
    }
  },
  // Default posture: deny every unknown tool first, then re-allow only the
  // local/native tools and explicitly configured surfaces. Last matching
  // permission wins, so per-agent allows can override this global deny.
  "permission": {
    "*": "deny",
    "doom_loop": "ask",
    "external_directory": "ask",
    "canvas_*": "allow",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "compress": "allow",
    "sqz": "allow",
    "sqz_compress": "allow",
    "sqz_passthrough": "allow",
    "lsp": "allow",
    "task": "deny",
    "websearch": "deny",
    "websearch_cited": "deny",
    "webfetch": "deny",
    "context7_*": "deny",
    "exa_*": "deny",
    "gh_grep_*": "deny",
    "duckduckgo_*": "deny",
    "semble_*": "deny",
    "composio_*": "deny",
    "ebay_*": "deny",
    "home_assistant_*": "deny",
    "tinyfish_search": "deny",
    "retrieval_control": "deny"
  },
  "default_agent": "build",
  "subagent_depth": 1,
  "agent": {
    "build": {
      "description": "Primary supervising implementation agent. Owns the objective, research breadth, evidence sufficiency, and budget/extension decisions. Delegates execution and one end-to-end Composio workflow.",
      "model": "openrouter/gpt-6-luna",
      "options": { "reasoningEffort": "high", "reasoningSummary": "detailed" },
      "temperature": 0.2,
      "mode": "primary",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "skill": "allow",
        "question": "allow",
        "todowrite": "allow",
        "plan_enter": "allow",
        "plan_exit": "allow",
        "sqz_sqz_read_file": "allow",
        "sqz_sqz_list_dir": "allow",
        "sqz_sqz_grep": "allow",
        "sqz_expand": "allow",
        "write": "deny",
        "edit": "deny",
        "patch": "deny",
        "bash": "deny",
        "websearch": "deny",
        "websearch_cited": "deny",
        "webfetch": "deny",
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "duckduckgo_*": "deny",
        "semble_*": "deny",
        "composio_*": "deny",
        "ebay_*": "deny",
        "tinyfish_search": "deny",
        // Preserve the authorized Home Assistant capability on the interactive primary.
        "home_assistant_*": "allow",
        // Parent-only budget extension for a fetch child; the plugin enforces target/action.
        "retrieval_control": "allow",
        "task": {
          "*": "deny",
          "code": "allow",
          "explore": "allow",
          "fetch": "allow",
          "track": "allow",
          "review": "allow",
          "composio": "allow"
        }
      }
    },

    "plan": {
      "description": "Primary planning agent. Read-only; delegates exploration, retrieval, tracker operations, and one end-to-end Composio workflow. Does not delegate code.",
      "model": "openrouter/gpt-6-luna",
      "options": { "reasoningEffort": "high", "reasoningSummary": "detailed" },
      "temperature": 0.25,
      "mode": "primary",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "skill": "allow",
        "question": "allow",
        "todowrite": "allow",
        "plan_enter": "allow",
        "plan_exit": "allow",
        "sqz_sqz_read_file": "allow",
        "sqz_sqz_list_dir": "allow",
        "sqz_sqz_grep": "allow",
        "sqz_expand": "allow",
        "write": "deny",
        "edit": "deny",
        "patch": "deny",
        "bash": "deny",
        "websearch": "deny",
        "websearch_cited": "deny",
        "webfetch": "deny",
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "duckduckgo_*": "deny",
        "semble_*": "deny",
        "composio_*": "deny",
        "ebay_*": "deny",
        "tinyfish_search": "deny",
        "home_assistant_*": "deny",
        "retrieval_control": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "fetch": "allow",
          "track": "allow",
          "composio": "allow"
        }
      }
    },

    "code": {
      "description": "Scoped implementation worker. Local code edits and narrow verification only. No external web/MCP, no children.",
      "hidden": true,
      "model": "openrouter/deepseek-v4.1-flash-1017",
      "options": { "reasoningEffort": "low", "reasoningSummary": "auto" },
      "temperature": 0.35,
      "mode": "subagent",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "skill": "allow",
        "sqz_sqz_read_file": "allow",
        "sqz_sqz_list_dir": "allow",
        "sqz_sqz_grep": "allow",
        "sqz_expand": "allow",
        "write": "allow",
        "edit": "allow",
        "patch": "allow",
        "apply_patch": "allow",
        "bash": {
          "*": "allow",
          // Not a network sandbox: package installs and similar tools can still
          // reach the network. Deny only obvious direct web-fetch commands.
          "curl *": "deny",
          "curl.exe *": "deny",
          "wget *": "deny",
          "wget.exe *": "deny",
          "Invoke-WebRequest*": "deny",
          "Invoke-RestMethod*": "deny",
          "iwr *": "deny",
          "irm *": "deny",
          "Start-BitsTransfer*": "deny",
          "git clone *": "deny"
        },
        "websearch": "deny",
        "websearch_cited": "deny",
        "webfetch": "deny",
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "duckduckgo_*": "deny",
        "semble_*": "deny",
        "composio_*": "deny",
        "ebay_*": "deny",
        "home_assistant_*": "deny",
        "tinyfish_search": "deny",
        "retrieval_control": "deny",
        "task": {
          "*": "deny"
        }
      }
    },

    "review": {
      "description": "Read-only review worker. Correctness, regressions, scope, and verification. No external web/MCP, no children.",
      "model": "openrouter/deepseek-v4.1-flash-1017",
      "options": { "reasoningEffort": "low", "reasoningSummary": "auto" },
      "temperature": 0.1,
      "mode": "subagent",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "skill": "allow",
        "sqz_sqz_read_file": "allow",
        "sqz_sqz_list_dir": "allow",
        "sqz_sqz_grep": "allow",
        "sqz_expand": "allow",
        "write": "deny",
        "edit": "deny",
        "patch": "deny",
        "websearch": "deny",
        "websearch_cited": "deny",
        "webfetch": "deny",
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "duckduckgo_*": "deny",
        "semble_*": "deny",
        "composio_*": "deny",
        "ebay_*": "deny",
        "home_assistant_*": "deny",
        "tinyfish_search": "deny",
        "retrieval_control": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    },

    "explore": {
      "description": "Local reconnaissance worker. Read-only local files and Semble local semantic search. Remote git repo URLs are not allowed. No web, no children.",
      "model": "openrouter/deepseek-v4.1-flash",
      "options": { "reasoningEffort": "low", "reasoningSummary": "auto" },
      "hidden": true,
      "temperature": 0.2,
      "mode": "subagent",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "sqz_sqz_read_file": "allow",
        "sqz_sqz_list_dir": "allow",
        "sqz_sqz_grep": "allow",
        "sqz_expand": "allow",
        "write": "deny",
        "edit": "deny",
        "patch": "deny",
        "websearch": "deny",
        "websearch_cited": "deny",
        "webfetch": "deny",
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "duckduckgo_*": "deny",
        "composio_*": "deny",
        "ebay_*": "deny",
        "home_assistant_*": "deny",
        "tinyfish_search": "deny",
        "retrieval_control": "deny",
        // Local semantic search only; the policy plugin rejects remote git repo URLs.
        "semble_*": "allow",
        "bash": {
          "*": "deny",
          "ls *": "allow",
          "tree *": "allow",
          "cat *": "allow",
          "grep *": "allow",
          "rg *": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    },

    "fetch": {
      "description": "Sole external retrieval worker. Budgeted web search/fetch via DuckDuckGo, TinyFish, Exa, Context7, and gh_grep. No synthesis, no children.",
      "model": "openrouter/deepseek-v4.1-flash",
      "options": { "reasoningEffort": "low", "reasoningSummary": "auto" },
      "temperature": 0.1,
      "mode": "subagent",
      "hidden": true,
      "steps": 10,
      "permission": {
        "websearch": "allow",
        "websearch_cited": "allow",
        "webfetch": "allow",
        "context7_*": "allow",
        "exa_*": "allow",
        "gh_grep_*": "allow",
        "duckduckgo_*": "allow",
        // Custom policy-plugin tools: search-only TinyFish and status-only retrieval_control.
        "tinyfish_search": "allow",
        "retrieval_control": "allow",
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "skill": "deny",
        "question": "deny",
        "todowrite": "deny",
        "lsp": "deny",
        "sqz_sqz_read_file": "deny",
        "sqz_sqz_list_dir": "deny",
        "sqz_sqz_grep": "deny",
        "sqz_expand": "deny",
        "write": "deny",
        "edit": "deny",
        "patch": "deny",
        "bash": "deny",
        "semble_*": "deny",
        "composio_*": "deny",
        "ebay_*": "deny",
        "home_assistant_*": "deny",
        "task": {
          "*": "deny"
        }
      }
    },

    "track": {
      "description": "Beads tracker worker. Scoped br/bv only; no code edits, web, or children.",
      "model": "openrouter/deepseek-v4.1-flash",
      "options": { "reasoningEffort": "low", "reasoningSummary": "auto" },
      "temperature": 0.1,
      "mode": "subagent",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "skill": "allow",
        "sqz_sqz_read_file": "deny",
        "sqz_sqz_list_dir": "deny",
        "sqz_sqz_grep": "deny",
        "sqz_expand": "deny",
        "question": "deny",
        "todowrite": "deny",
        "lsp": "deny",
        "write": "deny",
        "edit": "deny",
        "patch": "deny",
        "websearch": "deny",
        "websearch_cited": "deny",
        "webfetch": "deny",
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "duckduckgo_*": "deny",
        "semble_*": "deny",
        "composio_*": "deny",
        "ebay_*": "deny",
        "home_assistant_*": "deny",
        "tinyfish_search": "deny",
        "retrieval_control": "deny",
        "bash": {
          "*": "deny",
          "br *": "allow",
          // Destructive tracker operations keep the approval convention.
          "br delete*": "ask",
          "br close*": "ask",
          // bv is robot-only; never interactive and never --no-db.
          "bv --robot-*": "allow",
          "bv *--no-db*": "deny"
        },
        "task": {
          "*": "deny"
        }
      }
    },

    "composio": {
      "description": "Dedicated Composio worker. Owns one entire external-app workflow end-to-end. No children, no web, no local mutations.",
      "model": "openrouter/deepseek-v4.1-flash-1017",
      "options": { "reasoningEffort": "low", "reasoningSummary": "auto" },
      "temperature": 0.35,
      "mode": "subagent",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "skill": "allow",
        "composio_*": "allow",
        "sqz_sqz_read_file": "deny",
        "sqz_sqz_list_dir": "deny",
        "sqz_sqz_grep": "deny",
        "sqz_expand": "deny",
        "question": "deny",
        "todowrite": "deny",
        "lsp": "deny",
        "write": "deny",
        "edit": "deny",
        "patch": "deny",
        "bash": "deny",
        "websearch": "deny",
        "websearch_cited": "deny",
        "webfetch": "deny",
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "duckduckgo_*": "deny",
        "semble_*": "deny",
        "ebay_*": "deny",
        "home_assistant_*": "deny",
        "tinyfish_search": "deny",
        "retrieval_control": "deny",
        "task": {
          "*": "deny"
        }
      }
    }
  }
}
