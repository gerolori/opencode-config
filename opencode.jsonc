{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "openrouter/openai/gpt-6-luna",
  "small_model": "openrouter/free",
  "compaction": {
    "auto": true,
    "keep": { "tokens": 40000 },
    "buffer": 100000
  },
  "instructions": ["instructions/*.md"],
  "provider": {
    "openrouter": {
      "options": {},
      "models": {
        "free": {
          "id": "openrouter/free",
          "name": "Free Models Router",
          "reasoning": false,
          "limit": { "context": 200000, "output": 16384 }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "reasoning": true,
          "options": { "reasoningEffort": "high", "reasoningSummary": "auto" },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "reasoning": true,
          "options": { "reasoningEffort": "high", "reasoningSummary": "auto" },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "reasoning": true,
          "options": { "reasoningEffort": "medium", "reasoningSummary": "auto" },
          "limit": { "context": 1048576, "output": 32768 }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "reasoning": false,
          "options": { "reasoningSummary": "auto" },
          "limit": { "context": 1048576, "output": 16384 }
        }
      }
    },
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "no-key-required"
      },
      "models": {
        "qwen-27b": {
          "name": "Qwen 3.6 27B",
          "reasoning": true,
          "limit": { "context": 96000, "output": 65536 }
        }
      }
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "cc-safety-net",
    "@tarquinen/opencode-smart-title@latest",
    "@bastiangx/opencode-unmoji@latest",
    "opencode-ntfy.sh"
  ],
  "command": {
    "mystatus": {
      "description": "Query quota usage for all AI accounts",
      "template": "Use the mystatus tool to query quota usage. Return the result as-is without modification."
    }
  },
  "mcp": {
    "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp", "enabled": true },
    "exa": { "type": "remote", "url": "https://mcp.exa.ai/mcp", "enabled": true },
    "gh_grep": { "type": "remote", "url": "https://mcp.grep.app", "enabled": true },
    "sqz": {
      "type": "local",
      "command": ["C:\\Users\\hermes\\.cargo\\bin\\sqz-mcp.exe"],
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": [
        "C:\\Users\\hermes\\AppData\\Local\\Programs\\Python\\Python39\\Scripts\\uvx.exe",
        "--python", "3.11",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    },
    "semble": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "C:/Users/hermes/mcp-servers/semble",
        "run",
        "semble"
      ],
      "enabled": true
    },
    "home_assistant": {
      "type": "remote",
      "url": "https://homeassistant.gerosalorenzo.com/api/mcp",
      "headers": {
        "Authorization": "Bearer {env:HA_BEARER_TOKEN}"
      },
      "enabled": true
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "oauth": {},
      "enabled": true
    }
  },
  "permission": {
    "canvas_*": "allow",
    "task": "deny",
    "websearch": "allow",
    "websearch_cited": "allow",
    "sqz": "allow"
  },
  "default_agent": "build",
  "subagent_depth": 2,

"agent": {
  "build": {
    "description": "Supervising implementation agent. Owns the global task, delegates execution, and keeps coherence across subagents. When Composio is needed, delegate the complete external-app workflow to the composio agent in one task; pass any prior COMPOSIO_CONTEXT_V1 verbatim; do not split discovery/connection/execution across multiple children. Prevent duplicate tool calls: if a tool already returned data for the same query, do not call it again. After native compaction resumes, re-read the task objective and continue from the last actionable state without repeating completed work.",
    "model": "openrouter/openai/gpt-6-luna",
    "reasoningEffort": "high",
    "options": { "reasoningSummary": "detailed" },
    "temperature": 0.2,
    "mode": "primary",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "deny",
      "edit": "deny",
      "patch": "deny",

      "duckduckgo_*": "deny",
      "websearch*": "deny",
      "webfetch*": "deny",
      "context7_*": "deny",
      "exa_*": "deny",
      "gh_grep_*": "deny",
      "composio_*": "deny",
      "bash": "deny",

      "task": {
        "*": "deny",
        "code": "allow",
        "explore": "allow",
        "research": "allow",
        "review": "allow",
        "composio": "allow"
      }
    }
  },

  "plan": {
    "description": "Planning and analysis agent. Read-only by default and optimized for delegation. When Composio is needed, delegate the complete external-app workflow to the composio agent in one task; pass any prior COMPOSIO_CONTEXT_V1 verbatim; do not ask for full tool catalogs or repeated connection details. Prevent duplicate tool calls: if a tool already returned data for the same query, do not call it again. After native compaction resumes, re-read the task objective and continue from the last actionable state without repeating completed work.",
    "model": "openrouter/openai/gpt-6-luna",
    "reasoningEffort": "high",
    "options": { "reasoningSummary": "detailed" },
    "temperature": 0.25,
    "mode": "primary",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "deny",
      "edit": "deny",
      "patch": "deny",

      "duckduckgo_*": "deny",
      "websearch*": "deny",
      "webfetch*": "deny",
      "context7_*": "deny",
      "exa_*": "deny",
      "gh_grep_*": "deny",
      "composio_*": "deny",
      "bash": "deny",

      "task": {
        "*": "deny",
        "research": "allow",
        "explore": "allow",
        "composio": "allow"
      }
    }
  },

  "code": {
    "description": "Tactical execution agent. Makes scoped code changes and runs narrow verification commands. Do NOT call Composio tools directly; only build/plan may route to the composio agent.",
    "hidden": true,
    "model": "openrouter/deepseek-v4.1-flash-1017",
    "reasoningEffort": "medium",
    "temperature": 0.35,
    "options": { "reasoningSummary": "auto" },
    "mode": "subagent",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "allow",
      "edit": "allow",
      "composio_*": "deny",
      "bash": "allow",

      "task": {
        "*": "deny"
      }
    }
  },

  "review": {
    "description": "Strict read-only reviewer focused on correctness, regressions, and scope control. Do NOT call Composio tools directly; only build/plan may route to the composio agent.",
    "model": "openrouter/deepseek-v4.1-flash-1017",
    "reasoningEffort": "medium",
    "options": { "reasoningSummary": "auto" },
    "temperature": 0.1,
    "mode": "subagent",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "deny",
      "edit": "deny",
      "composio_*": "deny",
      "bash": {
        "git status*": "allow",
        "git diff*": "allow",
        "git log*": "allow",
        "*": "deny"
      },
      "task": {
        "*": "deny"
      }
    }
  },

  "research": {
    "description": "Deep research agent. Decomposes questions, delegates retrieval to fetcher, and synthesizes sourced conclusions. Do NOT call Composio tools directly; only build/plan may route to the composio agent.",
    "model": "openrouter/deepseek-v4.1-flash-1017",
    "reasoningEffort": "medium",
    "options": { "reasoningSummary": "detailed" },
    "temperature": 0.35,
    "mode": "subagent",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "deny",
      "edit": "allow",
      "websearch": "deny",
      "webfetch": "deny",
      "composio_*": "deny",
      "bash": "deny",
      "task": {
        "*": "deny",
        "fetch": "allow"
      }
    }
  },

  "fetch": {
    "description": "Web retrieval worker. Executes searches and fetches, extracts relevant findings, and returns structured results without synthesis. Do NOT call Composio tools directly; only build/plan may route to the composio agent.",
    "model": "openrouter/deepseek-v4.1-flash",
    "reasoningEffort": "low",
    "options": { "reasoningSummary": "auto" },
    "temperature": 0.1,
    "mode": "subagent",
    "hidden": true,
    "permission": {
      "websearch": "allow",
      "webfetch": "allow",
      "read": "deny",
      "glob": "deny",
      "grep": "deny",
      "write": "deny",
      "edit": "deny",
      "composio_*": "deny",
      "bash": "deny",
      "task": {
        "*": "deny"
      }
    }
  },

  "explore": {
    "description": "Read-only codebase scout for reconnaissance and file discovery. Do NOT call Composio tools directly; only build/plan may route to the composio agent.",
    "model": "openrouter/deepseek-v4.1-flash",
    "reasoningEffort": "low",
    "options": { "reasoningSummary": "auto" },
    "hidden": true,
    "temperature": 0.2,
    "mode": "subagent",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "write": "deny",
      "edit": "deny",
      "composio_*": "deny",
      "bash": {
        "ls *": "allow",
        "tree *": "allow",
        "cat *": "allow",
        "grep *": "allow",
        "rg *": "allow",
        "*": "deny"
      },
      "task": {
        "*": "deny"
      }
    }
  },

  "composio": {
    "description": "Dedicated Composio workflow agent. Owns discovery, selected schema retrieval, auth/connection checks, execution, verification, and final reporting internally. Reuses a supplied COMPOSIO_CONTEXT_V1 when available; performs one end-to-end workflow per invocation and returns a compact verified summary plus updated context. Does not expose full tool catalogs/schemas unless explicitly requested for debugging. Never delegates further. Always passes model hint \"deepseek/deepseek-v4.1-flash-1017\" to COMPOSIO_SEARCH_TOOLS for optimal planning.",
    "model": "openrouter/deepseek-v4.1-flash-1017",
    "reasoningEffort": "medium",
    "options": { "reasoningSummary": "auto" },
    "temperature": 0.35,
    "mode": "subagent",
    "permission": {
      "read": "allow",
      "glob": "allow",
      "grep": "allow",
      "composio_*": "allow",
      "write": "deny",
      "edit": "deny",
      "bash": "deny",
      "task": {
        "*": "deny"
      }
    }
  }
}
}