{
  "$schema": "https://opencode.ai/config.json",
  // Native OpenCode 2.2.5 configuration. Upgrade deliberately; do not enable
  // legacy 1.x plugins here.
  "update": "disable",
  "model": {
    "providerID": "openrouter",
    "model": "gpt-6-luna",
    "variant": "high"
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 40000 },
    "buffer": 100000
  },
  "instructions": ["instructions/*.md"],
  "websearch": { "provider": "tinyfish" },
  "plugins": [
    "@tarquinen/opencode-dcp@3.2.0",
    "cc-safety-net@2.7.2"
  ],
  "providers": {
    "openrouter": {
      "name": "OpenRouter",
      "canonical": "openrouter",
      "package": "@opencode/ai/providers/openrouter",
      "models": {
        "free": {
          "modelID": "openrouter/free",
          "name": "Free Models Router",
          "capabilities": { "reasoning": { "supported": false } },
          "limit": { "context": 200000, "output": 16384 }
        },
        "gpt-5.6-luna": {
          "modelID": "openai/gpt-5.6-luna",
          "name": "GPT-5.6 Luna",
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high", "max"] },
            "temperature": true,
            "tools": true
          },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-6-luna": {
          "modelID": "openai/gpt-6-luna",
          "name": "GPT-6 Luna",
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high", "max"] },
            "temperature": true,
            "tools": true
          },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "deepseek-v4.1-flash-1017": {
          "modelID": "deepseek/deepseek-v4.1-flash-1017",
          "name": "DeepSeek V4.1 Flash 1017",
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high", "max"] },
            "temperature": true,
            "tools": true
          },
          "limit": { "context": 1048576, "output": 32768 }
        },
        "deepseek-v4.1-flash": {
          "modelID": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high", "max"] },
            "temperature": true,
            "tools": true
          },
          "limit": { "context": 1048576, "output": 16384 }
        }
      }
    },
    "llamacpp": {
      "name": "Local Llama.cpp",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "no-key-required"
      },
      "models": {
        "qwen-27b": {
          "name": "Qwen 3.6 27B",
          "capabilities": { "reasoning": { "supported": true } },
          "limit": { "context": 96000, "output": 65536 }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false,
        "codemode": true
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false,
        "codemode": true
      },
      "sqz": {
        "type": "local",
        "command": ["sqz-mcp"],
        "disabled": false,
        "codemode": false
      },
      "duckduckgo": {
        "type": "local",
        "command": ["uvx", "--python", "3.11", "duckduckgo-mcp-server"],
        "disabled": false,
        "codemode": true
      },
      // Conditional: host-config enables this entry only when the local project
      // directory (EBAY_MCP_DIR or ~/mcp-servers/ebay) and both eBay
      // credentials are present in the service environment. Host-config writes
      // the effective command and child environment in memory; no credential
      // value is stored in this file.
      "ebay": {
        "type": "local",
        "command": ["uv", "--directory", "{env:EBAY_MCP_DIR}", "run", "ebay-mcp"],
        "environment": {
          "EBAY_CLIENT_ID": "{env:EBAY_CLIENT_ID}",
          "EBAY_CLIENT_SECRET": "{env:EBAY_CLIENT_SECRET}",
          "EBAY_ENV": "{env:EBAY_ENV}"
        },
        "disabled": true,
        "codemode": false
      },
      "composio": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp",
        "oauth": {},
        "disabled": false,
        "codemode": true
      }
    }
  },
  // Unknown tools and MCP namespaces are denied first. Global rules cover
  // local/native tools; agent rules add role-specific allows. Last match wins.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },
    { "action": "doom_loop", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "lsp", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "todowrite", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "execute", "resource": "*", "effect": "deny" },
    { "action": "context7_*", "resource": "*", "effect": "deny" },
    { "action": "exa_*", "resource": "*", "effect": "deny" },
    { "action": "gh_grep_*", "resource": "*", "effect": "deny" },
    { "action": "duckduckgo_*", "resource": "*", "effect": "deny" },
    { "action": "semble_*", "resource": "*", "effect": "deny" },
    { "action": "composio_*", "resource": "*", "effect": "deny" },
    { "action": "ebay_*", "resource": "*", "effect": "deny" },
    { "action": "home_assistant_*", "resource": "*", "effect": "deny" },
    { "action": "retrieval_control", "resource": "*", "effect": "deny" },
    { "action": "sqz_sqz_read_file", "resource": "*", "effect": "deny" },
    { "action": "sqz_sqz_list_dir", "resource": "*", "effect": "deny" },
    { "action": "sqz_sqz_grep", "resource": "*", "effect": "deny" },
    { "action": "sqz_expand", "resource": "*", "effect": "deny" }
  ],
  "default_agent": "build",
  "experimental": {
    "todo": true,
    "subagent_depth": 1
  },
  "agents": {
    "general": {
      "disabled": true
    },
    "build": {
      "description": "Primary supervising implementation agent. Owns the objective, research breadth, evidence sufficiency, and budget/extension decisions. Delegates execution and one end-to-end Composio workflow.",
      "model": { "providerID": "openrouter", "model": "gpt-6-luna", "variant": "high" },
      "request": { "body": { "temperature": 0.2 } },
      "mode": "primary",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "compress", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "worktree-flow", "effect": "allow" },
        { "action": "skill", "resource": "review-flow", "effect": "allow" },
        { "action": "skill", "resource": "composio-google-sheets", "effect": "allow" },
        { "action": "skill", "resource": "customize-opencode", "effect": "allow" },
        { "action": "sqz_sqz_read_file", "resource": "*", "effect": "allow" },
        { "action": "sqz_sqz_list_dir", "resource": "*", "effect": "allow" },
        { "action": "sqz_sqz_grep", "resource": "*", "effect": "allow" },
        { "action": "sqz_expand", "resource": "*", "effect": "allow" },
        { "action": "sqz_compress", "resource": "*", "effect": "allow" },
        { "action": "sqz_passthrough", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "home_assistant_*", "resource": "*", "effect": "allow" },
        { "action": "retrieval_control", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "code", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "fetch", "effect": "allow" },
        { "action": "subagent", "resource": "track", "effect": "allow" },
        { "action": "subagent", "resource": "review", "effect": "allow" },
        { "action": "subagent", "resource": "composio", "effect": "allow" }
      ]
    },
    "plan": {
      "description": "Primary planning agent. Read-only; delegates exploration, retrieval, tracker operations, and one end-to-end Composio workflow. Does not delegate code.",
      "model": { "providerID": "openrouter", "model": "gpt-6-luna", "variant": "high" },
      "request": { "body": { "temperature": 0.25 } },
      "mode": "primary",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "compress", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "worktree-flow", "effect": "allow" },
        { "action": "skill", "resource": "review-flow", "effect": "allow" },
        { "action": "skill", "resource": "composio-google-sheets", "effect": "allow" },
        { "action": "skill", "resource": "customize-opencode", "effect": "allow" },
        { "action": "sqz_sqz_read_file", "resource": "*", "effect": "allow" },
        { "action": "sqz_sqz_list_dir", "resource": "*", "effect": "allow" },
        { "action": "sqz_sqz_grep", "resource": "*", "effect": "allow" },
        { "action": "sqz_expand", "resource": "*", "effect": "allow" },
        { "action": "sqz_compress", "resource": "*", "effect": "allow" },
        { "action": "sqz_passthrough", "resource": "*", "effect": "allow" },
        { "action": "retrieval_control", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "fetch", "effect": "allow" },
        { "action": "subagent", "resource": "track", "effect": "allow" },
        { "action": "subagent", "resource": "composio", "effect": "allow" }
      ]
    },
    "code": {
      "description": "Scoped implementation worker. Local code edits and narrow verification only. No external web/MCP, no children.",
      "model": { "providerID": "openrouter", "model": "deepseek-v4.1-flash-1017", "variant": "low" },
      "request": { "body": { "temperature": 0.35 } },
      "mode": "subagent",
      "hidden": false,
      "permissions": [
        { "action": "skill", "resource": "worktree-flow", "effect": "allow" },
        { "action": "sqz_sqz_read_file", "resource": "*", "effect": "allow" },
        { "action": "sqz_sqz_list_dir", "resource": "*", "effect": "allow" },
        { "action": "sqz_sqz_grep", "resource": "*", "effect": "allow" },
        { "action": "sqz_expand", "resource": "*", "effect": "allow" },
        { "action": "sqz_compress", "resource": "*", "effect": "allow" },
        { "action": "sqz_passthrough", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "curl *", "effect": "deny" },
        { "action": "shell", "resource": "curl.exe *", "effect": "deny" },
        { "action": "shell", "resource": "wget *", "effect": "deny" },
        { "action": "shell", "resource": "wget.exe *", "effect": "deny" },
        { "action": "shell", "resource": "Invoke-WebRequest*", "effect": "deny" },
        { "action": "shell", "resource": "Invoke-RestMethod*", "effect": "deny" },
        { "action": "shell", "resource": "iwr *", "effect": "deny" },
        { "action": "shell", "resource": "irm *", "effect": "deny" },
        { "action": "shell", "resource": "Start-BitsTransfer*", "effect": "deny" },
        { "action": "shell", "resource": "git clone *", "effect": "deny" }
      ]
    },
    "review": {
      "description": "Read-only review worker. Correctness, regressions, scope, and verification. No external web/MCP, no children.",
      "model": { "providerID": "openrouter", "model": "deepseek-v4.1-flash-1017", "variant": "low" },
      "request": { "body": { "temperature": 0.1 } },
      "mode": "subagent",
      "permissions": [
        { "action": "skill", "resource": "review-flow", "effect": "allow" },
        { "action": "sqz_sqz_read_file", "resource": "*", "effect": "allow" },
        { "action": "sqz_sqz_list_dir", "resource": "*", "effect": "allow" },
        { "action": "sqz_sqz_grep", "resource": "*", "effect": "allow" },
        { "action": "sqz_expand", "resource": "*", "effect": "allow" },
        { "action": "sqz_compress", "resource": "*", "effect": "allow" },
        { "action": "sqz_passthrough", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" }
      ]
    },
    "explore": {
      "description": "Local reconnaissance worker. Read-only local files and Semble local semantic search through Code Mode. Remote git repo URLs are not allowed. No web, no children.",
      "model": { "providerID": "openrouter", "model": "deepseek-v4.1-flash", "variant": "low" },
      "request": { "body": { "temperature": 0.2 } },
      "mode": "subagent",
      "hidden": false,
      "permissions": [
        { "action": "sqz_sqz_read_file", "resource": "*", "effect": "allow" },
        { "action": "sqz_sqz_list_dir", "resource": "*", "effect": "allow" },
        { "action": "sqz_sqz_grep", "resource": "*", "effect": "allow" },
        { "action": "sqz_expand", "resource": "*", "effect": "allow" },
        { "action": "sqz_compress", "resource": "*", "effect": "allow" },
        { "action": "sqz_passthrough", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "semble_*", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "tree *", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "grep *", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" }
      ]
    },
    "fetch": {
      "description": "Sole external retrieval worker. Budgeted native web search/fetch plus Code Mode retrieval providers. No synthesis, no children.",
      "model": { "providerID": "openrouter", "model": "deepseek-v4.1-flash", "variant": "low" },
      "request": { "body": { "temperature": 0.1 } },
      "mode": "subagent",
      "hidden": false,
      "steps": 10,
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "exa_*", "resource": "*", "effect": "allow" },
        { "action": "gh_grep_*", "resource": "*", "effect": "allow" },
        { "action": "duckduckgo_*", "resource": "*", "effect": "allow" },
        { "action": "ebay_*", "resource": "*", "effect": "allow" },
        { "action": "retrieval_control", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "deny" },
        { "action": "glob", "resource": "*", "effect": "deny" },
        { "action": "grep", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" },
        { "action": "lsp", "resource": "*", "effect": "deny" },
        { "action": "sqz_sqz_read_file", "resource": "*", "effect": "deny" },
        { "action": "sqz_sqz_list_dir", "resource": "*", "effect": "deny" },
        { "action": "sqz_sqz_grep", "resource": "*", "effect": "deny" },
        { "action": "sqz_expand", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "track": {
      "description": "Beads tracker worker. Scoped br and bv --robot-* shell only; no code edits, web, or children.",
      "model": { "providerID": "openrouter", "model": "deepseek-v4.1-flash", "variant": "low" },
      "request": { "body": { "temperature": 0.1 } },
      "mode": "subagent",
      "permissions": [
        { "action": "skill", "resource": "beads-br", "effect": "allow" },
        { "action": "skill", "resource": "beads-bv", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "br *", "effect": "allow" },
        { "action": "shell", "resource": "br delete*", "effect": "ask" },
        { "action": "shell", "resource": "br close*", "effect": "ask" },
        { "action": "shell", "resource": "bv --robot-*", "effect": "allow" },
        { "action": "shell", "resource": "bv *--no-db*", "effect": "deny" },
        { "action": "sqz_sqz_read_file", "resource": "*", "effect": "deny" },
        { "action": "sqz_sqz_list_dir", "resource": "*", "effect": "deny" },
        { "action": "sqz_sqz_grep", "resource": "*", "effect": "deny" },
        { "action": "sqz_expand", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" },
        { "action": "lsp", "resource": "*", "effect": "deny" }
      ]
    },
    "composio": {
      "description": "Dedicated Composio worker. Owns one entire external-app workflow end-to-end through Code Mode. No children, no web, no local mutations.",
      "model": { "providerID": "openrouter", "model": "deepseek-v4.1-flash-1017", "variant": "low" },
      "request": { "body": { "temperature": 0.35 } },
      "mode": "subagent",
      "permissions": [
        { "action": "skill", "resource": "composio-google-sheets", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "composio_*", "resource": "*", "effect": "allow" },
        { "action": "sqz_sqz_read_file", "resource": "*", "effect": "deny" },
        { "action": "sqz_sqz_list_dir", "resource": "*", "effect": "deny" },
        { "action": "sqz_sqz_grep", "resource": "*", "effect": "deny" },
        { "action": "sqz_expand", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" },
        { "action": "lsp", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
