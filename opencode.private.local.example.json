{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "home_assistant": {
      "type": "remote",
      "url": "https://REPLACE_WITH_YOUR_HOME_ASSISTANT_DOMAIN/api/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer REPLACE_WITH_YOUR_HOME_ASSISTANT_TOKEN"
      }
    },
    "semble": {
      "type": "local",
      "command": ["uv", "--directory", "REPLACE_WITH_PATH_TO_SEMBLE_REPO", "run", "semble"],
      "enabled": true
    }
  }
}
