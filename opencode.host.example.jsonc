{
  "$schema": "https://opencode.ai/config.json",
  // Host-local MCP example for OpenCode 2.x. Load it with OPENCODE_CONFIG;
  // opencode merges it over the base config. It contains no credentials.
  //
  // Set host paths to forward-slash values, for example:
  //   SEMBLE_MCP_DIR=C:/Users/me/mcp-servers/semble
  //   EBAY_MCP_DIR=C:/Users/me/mcp-servers/ebay
  // eBay itself is host-added when its project and both credentials exist.
  "mcp": {
    "servers": {
      "semble": {
        "type": "local",
        "command": ["uv", "--directory", "{env:SEMBLE_MCP_DIR}", "run", "semble"],
        // Disabled by default: loading this example without SEMBLE_MCP_DIR
        // must not launch an empty command. Because an explicit entry wins,
        // this overlay intentionally suppresses Semble auto-detection. Omit
        // this entry, or set disabled:false with a valid directory, to use it.
        "disabled": true,
        "codemode": true
      }
      // eBay is intentionally not pinned here. An explicit entry would win
      // over host detection; host initialization adds eBay only when its local
      // project and both credentials exist in the service environment.
      // Do not pin a disabled placeholder in a host overlay.
    }
  }
}
